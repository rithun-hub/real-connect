# ============================================================
# REAL CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# NOTE: Copy this file to .env before starting the services.
# Never commit real credentials or private keys to version control.

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL + Prisma)
# Replace with your local or hosted PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/real_connect?schema=public

# Frontend Configuration (Vite)
VITE_SERVER_URL=http://localhost:5000

